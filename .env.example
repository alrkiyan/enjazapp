# ==============================================================================
# متغيّرات البيئة للواجهة (Frontend) — هذان المتغيّران فقط لا غير
# ==============================================================================
# رابط Supabase المستضاف ذاتياً (بوابة Kong) — تجده في خدمة Supabase على Coolify.
# استخدم رابط HTTPS العام حتى يعمل Realtime عبر wss.
VITE_SUPABASE_URL=https://supabase-api.your-domain.com

# مفتاح anon العام لنفس المشروع المستضاف (public anon key).
VITE_SUPABASE_ANON_KEY=your_selfhosted_anon_key

# ------------------------------------------------------------------------------
# ملاحظات مهمة:
# - هذان المتغيّران عامّان ويُخبَزان داخل حزمة المتصفح — هذا طبيعي وآمن.
# - لا تضع SERVICE_ROLE_KEY (مفتاح الخدمة) هنا أو في أي متغيّر VITE_ إطلاقاً.
# - على Coolify: أضِف المتغيّرين وعلّم كلاً منهما "Build Variable"
#   (وإلا يُبنى التطبيق بقيمة undefined ولن يتصل بـ Supabase).
# - محلياً: انسخ هذا الملف إلى .env وضع القيم الفعلية.
# ==============================================================================
